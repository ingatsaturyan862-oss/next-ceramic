model User {
  id            String    @id @default(cuid())
  name          String
  role          UserRole  @default(USER)
  email         String    @unique
  emailVerified Boolean
  image         String?
  session       Session[]
  account       Account[]
  basket        Basket?
  order         Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  ADMIN
  USER
}
