model Product {
  id Int @id @default(autoincrement())

  name   String
  price  Int
  text   String
  imgUrl String
  images String[]

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  color      Color[]
  basketCard BasketCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
